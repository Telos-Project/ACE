el\"][\"content\"] != str(scored[1]):\n\tif not patch[\"packages\"].has(\"score\"):\n\t\tpatch[\"packages\"][\"score\"] = {\"packages\": {}}\n\tpatch[\"packages\"][\"score\"][\"packages\"][\"right\"] = {\n\t\t\"utilities\": {\"label\": {\"content\": str(scored[1])}}\n\t}\n\nreturn JSON.stringify(patch)"
