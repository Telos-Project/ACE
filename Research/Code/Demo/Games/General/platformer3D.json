					"content": "const s = JSON.parse(state);\nconst E = s.packages.engine;\nconst time = E.utilities.time.properties.state;\nconst kb = E.packages.controllers.utilities['keyboard-0'];\nconst pt = E.packages.controllers.utilities['pointer-0'];\n\nconst me = s.packages.avatar;\nconst d = me.properties.meta.data;\nconst rig = s.packages.rig.properties.meta.data;\nconst dt = Math.min(time.delta, 0.1);\n\n// The simulation owns where the avatar is. The document reads that and asks\n// for a velocity; it never writes a position, which on a simulated body would\n// be a teleport and would fight the solver every frame.\nconst at = (me.properties.meta.state && me.properties.meta.state.position)\n\t|| d.position || [0, 0, 0];\n\nconst sim = me.utilities.body.properties.state || {};\nconst vel = sim.velocity || [0, 0, 0];\n\nconst half = d.half || 0.85;\n\nconst keys = kb ? kb.properties.state.digital : [];\nconst on = k => keys.indexOf(k) >= 0;\n\n// The camera is what forward means in a third person view, so it is turned\n// first and the avatar steered relative to where it ended up.\nlet yaw = rig.yaw || 0;\nlet pitch = rig.pitch != null ? rig.pitch : -0.28;\n\nif (pt) {\n\tconst a = pt.properties.state.analog;\n\tyaw -= (a.dx || 0) * 3.2;\n\tpitch += (a.dy || 0) * 3.2;\n\tpitch = Math.max(-1.0, Math.min(0.30, pitch));\n}\n\nconst forward = (on('KeyW') || on('ArrowUp') ? 1 : 0) - (on('KeyS') || on('ArrowDown') ? 1 : 0);\nconst strafe = (on('KeyD') || on('ArrowRight') ? 1 : 0) - (on('KeyA') || on('ArrowLeft') ? 1 : 0);\n\nconst sy = Math.sin(yaw), cy = Math.cos(yaw);\nlet mx = -sy * forward + cy * strafe;\nlet mz = -cy * forward - sy * strafe;\n\nconst push = Math.hypot(mx, mz);\nconst drive = Math.min(1, push);\n\nif (push > 1e-6) { mx /= push; mz /= push; }\n\n// Backing up is the one time a figure should not point where it is going,\n// and it is also the one time the backward clip suits it.\nconst backing = forward < 0 && Math.abs(forward) >= Math.abs(strafe);\nconst running = on('ShiftLeft') || on('ShiftRight');\nconst rate = running ? 8.4 : 3.4;\n\n// The probe casts down from the middle of the body, so it answers with what\n// is under the feet and never with what is over the head. Standing is a\n// matter of being close to that and not rising.\nconst probe = me.utilities.ground.properties.state;\nconst hits = probe ? probe.hits : null;\nconst floor = hits && hits.length ? hits[0].point[1] : null;\n\nconst clearance = floor != null ? (at[1] - half) - floor : 99;\nconst grounded = clearance < 0.22 && vel[1] < 1.5;\n\n// Falling is never taken back from the solver: the vertical is asked for only\n// on the frame a jump begins, and left alone on every other.\nlet vy = null;\nlet jumped = 0;\n\n// The velocity read here was taken before the last jump reached the solver,\n// so for a frame or two after leaving the ground the avatar still looks as\n// though she is standing on it. A short bar after each jump is what stops a\n// held key from launching her repeatedly.\nlet bar = Math.max(0, (d.bar || 0) - dt);\n\nif (grounded && bar === 0 && on('Space')) {\n\tvy = 9.4;\n\tjumped = 1;\n\tbar = 0.25;\n}\n\n// Falling is the solver's business, and so is everything the avatar runs\n// into. All the document decides is how fast it is trying to go.\n//\n// It steers toward that rather than setting it outright. A velocity written\n// over the top of the solver's own answer every frame discards the response\n// it just computed, and a body held against a wall grinds through it a\n// fraction at a time. Restoring only part of the difference each step leaves\n// the contact enough authority to hold.\n// In the air the avatar keeps what she had rather than being pulled toward a\n// slower target: a jump should carry momentum, not bleed it off and leave her\n// having to build speed again on landing. Weak steering aloft also stops a\n// body re-entering a wall at full power on every bounce, which is how a\n// contact is eventually pushed through.\nconst urge = Math.min(1, (grounded ? 18 : 1.6) * dt);\n\nconst wanted = [\n\tvel[0] + (mx * rate * drive - vel[0]) * urge,\n\tvy,\n\tvel[2] + (mz * rate * drive - vel[2]) * urge\n];\n\n// A null asks the simulation to keep what it has.\nif (vy === null) wanted[1] = null;\n\nconst moving = Math.hypot(vel[0], vel[2]);\n\nlet facing = d.facing || 0;\n\nif (drive > 0.01) {\n\tconst ax = backing ? -mx : mx;\n\tconst az = backing ? -mz : mz;\n\tconst want = Math.atan2(-ax, -az);\n\tlet turn = ((want - facing + Math.PI * 3) % (Math.PI * 2)) - Math.PI;\n\tfacing += turn * Math.min(1, 14 * dt);\n}\n\nlet clip = 'Idle';\nlet ratio = 1;\n\nif (!grounded) {\n\tclip = 'Idle';\n} else if (drive > 0.05) {\n\tif (backing) {\n\t\tclip = 'WalkingBack';\n\t\tratio = 1.1;\n\t} else {\n\t\tclip = 'Walking';\n\t\tratio = running ? 1.9 : 1.05;\n\t}\n}\n\n// The camera chases rather than being welded on, so a landing does not jolt\n// the view.\nconst chase = Math.min(1, 12 * dt);\nconst was = rig.position || at;\nconst rx = was[0] + (at[0] - was[0]) * chase;\nconst ry = was[1] + (at[1] - was[1]) * chase;\nconst rz = was[2] + (at[2] - was[2]) * chase;\n\nconst patch = { packages: {\n\tavatar: {\n\t\tproperties: { meta: { data: {\n\t\t\tfacing: facing,\n\t\t\tgrounded: grounded ? 1 : 0,\n\t\t\tbar: bar,\n\t\t\tclip: clip,\n\t\t\tspeed: moving,\n\t\t\tairborne: grounded ? 0 : 1\n\t\t} } },\n\t\tutilities: { body: { properties: { data: { velocity: wanted } } } }\n\t},\n\trig: {\n\t\tproperties: { meta: { data: {\n\t\t\tposition: [rx, ry, rz],\n\t\t\trotation: [0, yaw, 0],\n\t\t\tyaw: yaw,\n\t\t\tpitch: pitch\n\t\t} } },\n\t\tpackages: { arm: { properties: { meta: { data: {\n\t\t\trotation: [pitch, 0, 0]\n\t\t} } } } }\n\t}\n} };\n\n// The facing turns the model, not the body. Writing a rotation onto a\n// simulated entity is a teleport, and doing it every frame overwrites the\n// solver's own transform before every step.\npatch.packages.avatar.packages = { figure: {\n\tproperties: { meta: {