		"game": {
			"properties": {
				"meta": {
					"data": {
						"seed": 20260802,
						"score": 0,
						"due": 0,
						"wanted": 7,
						"yaw": 0,
						"pitch": 0,
						"eye": 1.6,
						"popped": 0,
